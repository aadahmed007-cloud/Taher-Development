# ============================================
# Taher Development - Environment Variables
# ============================================
# IMPORTANT: Never commit this file to version control.
# Use .env.example as a template for new deployments.

# ============================================
# DATABASE
# SQLite for development (default)
# For production PostgreSQL: postgresql://user:password@host:5432/taher_dev
# ============================================
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# ============================================
# NEXTAUTH
# Generate a strong secret: openssl rand -base64 32
# ============================================
NEXTAUTH_SECRET="taher-dev-secret-change-in-production-2024-x8k9m2"
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# APP URL
# Public URL of the deployed application
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# CLOUDINARY (Optional - Image CDN)
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Uncomment when ready for production
# ============================================
# CLOUDINARY_URL="cloudinary://123456789012345:abcdefg@taher-development"
# CLOUDINARY_UPLOAD_PRESET="taher_projects"
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="taher-development"
